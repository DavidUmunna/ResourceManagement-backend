    {
      "name": "Orders v1",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/orders?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "orders"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearerToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"supplier\": \"ABC Ltd\",\n  \"orderedBy\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"products\": [{\"name\": \"Item A\", \"quantity\": 2, \"price\": 1000}],\n  \"urgency\": \"High\",\n  \"remarks\": \"Please expedite\",\n  \"Title\": \"Laptop Purchase\",\n  \"staff\": \"<staffId>\",\n  \"role\": \"procurement_officer\",\n  \"targetDepartment\": \"IT\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Export Orders",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"startDate\": \"2024-01-01\",\n  \"endDate\": \"2024-12-31\",\n  \"status\": \"All\",\n  \"filename\": \"orders\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/orders/export", "host": ["{{baseUrl}}"], "path": ["api", "orders", "export"] }
          }
        },
        {
          "name": "Approve Order",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearerToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"adminName\": \"Manager\",\n  \"comment\": \"Looks good\",\n  \"SignatureData\": \"<base64>\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/orders/:id/approve", "host": ["{{baseUrl}}"], "path": ["api", "orders", ":id", "approve"] }
          }
        },
        {
          "name": "Reject Order",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearerToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"adminName\": \"Manager\",\n  \"comment\": \"Not approved\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/orders/:id/reject", "host": ["{{baseUrl}}"], "path": ["api", "orders", ":id", "reject"] }
          }
        },
        {
          "name": "Complete Order",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/orders/:id/completed", "host": ["{{baseUrl}}"], "path": ["api", "orders", ":id", "completed"] }
          }
        },
        {
          "name": "Update Status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"Pending\" }" },
            "url": { "raw": "{{baseUrl}}/api/orders/:id", "host": ["{{baseUrl}}"], "path": ["api", "orders", ":id"] }
          }
        },
        {
          "name": "Delete Order",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/orders/:id", "host": ["{{baseUrl}}"], "path": ["api", "orders", ":id"] }
          }
        }
      ]
