  "item": [
    {
      "name": "Auth & Access",
      "item": [
        {
          "name": "Check Access",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearerToken}}", "type": "text" }
            ],
            "url": { "raw": "{{baseUrl}}/api/access", "host": ["{{baseUrl}}"], "path": ["api", "access"] }
          }
        },
        {
          "name": "Signin (login)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/signin", "host": ["{{baseUrl}}"], "path": ["api", "signin"] }
          }
        },
        {
          "name": "Signin (get current)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/signin", "host": ["{{baseUrl}}"], "path": ["api", "signin"] }
          }
        },
        {
          "name": "Signin (logout)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"<userId>\",\n  \"deviceId\": \"<deviceId>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/signin/logout", "host": ["{{baseUrl}}"], "path": ["api", "signin", "logout"] }
          }
